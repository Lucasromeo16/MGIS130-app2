// LOGIC LAYER: Calculates team wins, losses, and overall stats summary.
function calculateTeamRecord() {
    let wins = 0;
    let losses = 0;
    let gf = 0;
    let ga = 0;

    gamesData.forEach(game => {
        if (game.completed) {
            gf += game.ritScore;
            ga += game.oppScore;
            if (game.ritScore > game.oppScore) wins++;
            else losses++;
        }
    });

    return { wins, losses, gf, ga, totalGames: wins + losses };
}

// LOGIC LAYER: Finds the next upcoming game from the dataset.
function getNextUpcomingGame() {
    return gamesData.find(g => !g.completed) || gamesData[gamesData.length - 1];
}

// LOGIC LAYER: Filters games list by home/away/completed category.
function filterGames(filterType) {
    if (filterType === "home") return gamesData.filter(g => g.isHome);
    if (filterType === "away") return gamesData.filter(g => !g.isHome);
    if (filterType === "completed") return gamesData.filter(g => g.completed);
    return gamesData;
}

// DISPLAY LAYER: Renders the top banner and next game countdown/details.
function renderNextGameBanner() {
    const nextGame = getNextUpcomingGame();
    const bannerContainer = document.getElementById("next-game-banner");

    if (!nextGame) return;

    bannerContainer.innerHTML = `
        <div class="banner-title">Next Matchup • ${nextGame.venue}</div>
        <div class="banner-matchup">
            <div class="team-box">
                <span class="team-name">RIT Tigers</span>
            </div>
            <div class="vs-badge">VS</div>
            <div class="team-box">
                <span class="team-name">${nextGame.opponent}</span>
            </div>
        </div>
        <div>
            <p style="font-size: 0.85rem; color: #ccc;">${nextGame.date} at ${nextGame.time}</p>
        </div>
    `;
}

// DISPLAY LAYER: Populates the schedule view with cards based on active filter.
function renderSchedule(filter = "all") {
    const listContainer = document.getElementById("schedule-list");
    const games = filterGames(filter);

    listContainer.innerHTML = games.map(game => {
        let resultClass = "upcoming";
        let scoreText = game.time;

        if (game.completed) {
            const isWin = game.ritScore > game.oppScore;
            resultClass = isWin ? "win" : "loss";
            scoreText = `${isWin ? 'W' : 'L'} ${game.ritScore}-${game.oppScore}`;
        }

        return `
            <div class="game-card ${resultClass}">
                <div class="game-info">
                    <span class="game-date">${game.date}</span>
                    <span class="game-opponent">${game.isHome ? 'vs' : '@'} ${game.opponent}</span>
                    <span class="game-location">${game.venue}</span>
                </div>
                <div class="game-score-box">
                    <div class="game-result ${game.completed ? (game.ritScore > game.oppScore ? 'result-W' : 'result-L') : ''}">${scoreText}</div>
                </div>
            </div>
        `;
    }).join("");
}

