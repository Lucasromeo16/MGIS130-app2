// DISPLAY LAYER: Renders roster cards.
function renderRoster() {
    const rosterGrid = document.getElementById("roster-grid");
    const allPlayers = [
        ...skatersData.map(s => ({ ...s, type: 'Skater' })),
        ...goaliesData.map(g => ({ ...g, pos: 'G', type: 'Goalie' }))
    ].sort((a, b) => a.num - b.num);

    rosterGrid.innerHTML = allPlayers.map(p => `
        <div class="player-card">
            <div class="player-number">#${p.num}</div>
            <div class="player-details">
                <h3>${p.name}</h3>
                <p>Position: ${p.pos}</p>
            </div>
        </div>
    `).join("");
}

// DISPLAY LAYER: Handles selection and rendering of game timeline play-by-play.
function renderPlayByPlay() {
    const selector = document.getElementById("pbp-game-select");
    const completedGames = gamesData.filter(g => g.completed);

    selector.innerHTML = completedGames.map(g => `
        <option value="${g.id}">vs ${g.opponent} (${g.date})</option>
    `).join("");

    const updateTimeline = (gameId) => {
        const game = gamesData.find(g => g.id === parseInt(gameId));
        const header = document.getElementById("pbp-game-header");
        const timeline = document.getElementById("pbp-timeline");

        header.innerHTML = `
            <h3>RIT ${game.ritScore} - ${game.oppScore} ${game.opponent}</h3>
            <p style="font-size: 0.8rem; color: #aaa;">${game.venue}</p>
        `;

        if (game.playByPlay.length === 0) {
            timeline.innerHTML = `<p style="font-size: 0.85rem; color: #888;">No events recorded.</p>`;
            return;
        }

        timeline.innerHTML = game.playByPlay.map(ev => `
            <div class="pbp-event">
                <span class="pbp-time">${ev.time}</span>
                <span class="pbp-desc">${ev.desc}</span>
            </div>
        `).join("");
    };

    selector.addEventListener("change", (e) => updateTimeline(e.target.value));
    if (completedGames.length > 0) updateTimeline(completedGames[0].id);
}

// DISPLAY LAYER: Renders player injuries and sets up tab switching UI listeners.
function renderInjuries() {
    const list = document.getElementById("injury-list");
    list.innerHTML = injuryData.map(i => `
        <div class="injury-card ${i.status === 'Day-to-Day' ? 'day-to-day' : ''}">
            <div class="injury-header">
                <h3>#${i.num} ${i.name}</h3>
                <span class="injury-status ${i.status === 'Day-to-Day' ? 'status-dtd' : 'status-out'}">${i.status}</span>
            </div>
            <p style="font-size: 0.85rem;"><strong>Position:</strong> ${i.pos}</p>
            <p style="font-size: 0.85rem;"><strong>Injury:</strong> ${i.injury}</p>
            <p style="font-size: 0.85rem; color: var(--rit-orange); margin-top: 0.25rem;"><strong>Timeline:</strong> ${i.returnDate}</p>
        </div>
    `).join("");
}

// LOGIC / DISPLAY LAYER: Application Initialization and Event Binding.
document.addEventListener("DOMContentLoaded", () => {
    renderNextGameBanner();
    renderSchedule();
    renderStats();
    renderRoster();
    renderPlayByPlay();
    renderInjuries();

    // Tab Switcher Listener
    document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
            document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
            document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));

            e.target.classList.add("active");
            const targetTab = e.target.getAttribute("data-tab");
            document.getElementById(`tab-${targetTab}`).classList.add("active");
        });
    });

    // Schedule Filter Listener
    document.querySelectorAll(".filter-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
            document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
            e.target.classList.add("active");
            renderSchedule(e.target.getAttribute("data-filter"));
        });
    });

    // Stats Sub-tab Switcher Listener
    document.querySelectorAll(".sub-tab-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
            document.querySelectorAll(".sub-tab-btn").forEach(b => b.classList.remove("active"));
            document.querySelectorAll(".stat-sub-view").forEach(v => v.classList.remove("active"));

            e.target.classList.add("active");
            const targetView = e.target.getAttribute("data-stat-tab");
            document.getElementById(`stat-${targetView}-view`).classList.add("active");
        });
    });
});
